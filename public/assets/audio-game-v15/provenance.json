 "generator": "scripts/generate-game-audio-v15.mjs",
 "method": "oscillator, filtered-noise and struck-partial synthesis with short decorrelated reflections and an algorithmic room; no samples or recordings",
 "key": "C major",
 "sampleRate": 44100,
 "meter": {
  "measured": "the shipped file (MP3s decoded again with ffmpeg); not auditioned",
  "momentaryLufs": "loudest 400 ms, ITU-R BS.1770 K-weighting; shorter files are measured against the full window, so brief cues compare by energy",
  "smallSpeakerLufs": "the same after a 400 Hz second-order high-pass, standing in for a phone speaker",
  "playedLufs": "mean of the two loudness figures + 20*log10(gain): where a call at gain 1 lands in the mix",
  "gain": "Part A: set so playedLufs equals that of the file replaced, which puts the full-range and small-speaker differences equally either side of zero. Part B: set to reach the level chosen for the cue",
  "replaces": "older files as the game played them: Howler centres a mono source 3.01 dB down in each ear",
  "headDbfs": "peak of the first 5 ms",
  "tailDbfs": "peak of the last 5 ms",
  "above8kHz": "share of spectral energy above 8 kHz",
  "centroidHz": "power-weighted mean frequency of the mid signal",
  "stereoCorrelation": "1 is mono; lower is wider"
 },
